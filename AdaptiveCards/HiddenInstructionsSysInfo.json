{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "ActionSet",
            "actions": [
                {
                    "type": "Action.ShowCard",
                    "title": "Show Instructions",
                    "card": {
                        "type": "AdaptiveCard",
                        "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
                        "version": "1.5",
                        "body": [
                            {
                                "type": "RichTextBlock",
                                "inlines": [
                                    {
                                        "type": "TextRun",
                                        "text": "Please follow the instructions to retreive the necessary system information:\n1. Goto the Windows Start Button.\n2. Type \"System Information\".\n3. Verify the Icon with the image below then click on the application."
                                    }
                                ]
                            },
                            {
                                "type": "Image",
                                "url": "https://github.com/Chinzillla/tier_2_digital_support_assistant/blob/main/SystemInfo.png?raw=true",
                                "width": "117px",
                                "height": "37px",
                                "spacing": "Small"
                            },
                            {
                                "type": "RichTextBlock",
                                "inlines": [
                                    {
                                        "type": "TextRun",
                                        "text": "4. Copy the following fields by selecting on the text and pressing Ctrl + C"
                                    }
                                ],
                                "spacing": "Small"
                            },
                            {
                                "type": "Image",
                                "url": "https://github.com/Chinzillla/tier_2_digital_support_assistant/blob/main/OperatingSystem.png?raw=true"
                            },
                            {
                                "type": "RichTextBlock",
                                "inlines": [
                                    {
                                        "type": "TextRun",
                                        "text": "5. Paste the details into the corresponding fields above"
                                    }
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    ]
}